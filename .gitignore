# ============================================================
# CodeGear - Root Git Ignore
# ============================================================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
dist/
.vite/

# -------------------------
# Java / Maven / Spring Boot
# -------------------------
target/
build/

# Keep source build directories if they somehow contain source-controlled files
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven wrapper generated binary
.mvn/wrapper/maven-wrapper.jar

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# IntelliJ IDEA
# -------------------------
.idea/
*.iws
*.iml
*.ipr

# -------------------------
# Eclipse / Spring Tool Suite
# -------------------------
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
.apt_generated

# -------------------------
# NetBeans
# -------------------------
/nbproject/private/
/nbbuild/
/nbdist/
build/

# -------------------------
# VS Code
# -------------------------
.vscode/

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# AI Agent Instructions
# -------------------------
AGENTS.md